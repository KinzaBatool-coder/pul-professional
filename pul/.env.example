# Copy this file to ".env" and fill in your values.

# --- Translation (needed for Saraiki and for best quality) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# auto = Claude if key is set, otherwise offline NLLB | llm | nllb
TRANSLATOR=auto

# --- Speech-to-text (Whisper) ---
# tiny | base | small | medium | large-v3   (bigger = better Urdu, slower)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto

# --- Server ---
HOST=127.0.0.1
PORT=8000
PRELOAD_MODELS=true
